# Maintainer: funkypitt <pierregallaz@gmail.com>
# Arch / Manjaro with COSMIC: cd packaging && makepkg -si
pkgname=quai
pkgver=0.2.1
pkgrel=1
pkgdesc="Two-column Unity-style dock for the COSMIC desktop"
arch=('x86_64' 'aarch64')
url="https://github.com/funkypitt/quai"
license=('GPL-3.0-or-later')
depends=('glibc')
makedepends=('cargo')
source=("$pkgname-$pkgver.tar.gz::https://github.com/funkypitt/quai/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$srcdir/quai-$pkgver"
  cargo build --release --locked
}

package() {
  cd "$srcdir/quai-$pkgver"
  install -Dm755 target/release/quai "$pkgdir/usr/bin/quai"
  sed 's|ExecStart=%h/.local/bin/quai|ExecStart=/usr/bin/quai|' data/quai.service > quai.service.pkg
  install -Dm644 quai.service.pkg "$pkgdir/usr/lib/systemd/user/quai.service"
  install -Dm644 data/quai.desktop "$pkgdir/usr/share/applications/quai.desktop"
  install -Dm644 data/quai.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/quai.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
